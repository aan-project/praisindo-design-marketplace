 "review": [
  {
   "old": "ErrState",
   "new": "ErrorState",
   "why": "ErrState and ErrorState are one component now: with no title and description it is the standard error with Retry; check props (onRetry, cta)."
  },
  {
   "old": "WoCard",
   "new": "Card",
   "why": "WoCard is Card without a title (class .card-bare); check that the body and actions props are used."
  },
  {
   "old": "Section",
   "new": "PlainSection",
   "why": "Only the layout helper Section is renamed; a variable or tag named Section is not."
  },
  {
   "old": ".ccb",
   "new": ".acc-b",
   "why": "Only the badge inside the accordion header changes; .ccb of the phone country button stays."
  },
  {
   "old": "Av",
   "new": "Avatar",
   "why": "Short names (Av, DR) are converted only as a JSX tag or an import, never as plain text."
  },
  {
   "old": "dr dr-s",
   "new": "dl-row",
   "why": "The row variant split is the DetailList layout rows: replace <DetailRow split> by <DetailItem> inside <DetailList layout=\"rows\">; the markup is <div class=\"dl-row\"><span class=\"mut\">label</span><div>value</div></div>."
  },
  {
   "old": "C3Field",
   "new": "DetailItem",
   "why": "C3Field becomes DetailItem inside a DetailList (grid); in HTML use <div class=\"dl-item\"><span>label</span><span class=\"fw6\">value</span></div>."
  }
 ],
